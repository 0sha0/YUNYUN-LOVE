#include <windows.h>

101 ICON "../assets/favicon.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "080404b0"
        BEGIN
            VALUE "CompanyName", "YUN-YUN-LOVE"
            VALUE "FileDescription", "YUN-YUN-LOVE Injector"
            VALUE "FileVersion", "1.0.0.0"
            VALUE "InternalName", "Injector"
            VALUE "LegalCopyright", "Copyright (C) 2026 YUN-YUN-LOVE - MIT License"
            VALUE "OriginalFilename", "Injector.exe"
            VALUE "ProductName", "YUN-YUN-LOVE"
            VALUE "ProductVersion", "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x804, 1200
    END
END