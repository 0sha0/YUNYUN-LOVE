#include <windows.h>

101 ICON "../assets/favicon.ico"
102 RCDATA "../assets/favicon.ico"   // 内嵌应用图标（关于页居中显示，走 WIC 从内存解码）

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x2L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "080404b0"
        BEGIN
            VALUE "CompanyName", "YUN-YUN-LOVE"
            VALUE "FileDescription", "YUN-YUN-LOVE Overlay DLL"
            VALUE "FileVersion", "1.0.0.0"
            VALUE "InternalName", "YunYunLove"
            VALUE "LegalCopyright", "Copyright (C) 2026 YUN-YUN-LOVE - MIT License"
            VALUE "OriginalFilename", "YunYunLove.dll"
            VALUE "ProductName", "YUN-YUN-LOVE"
            VALUE "ProductVersion", "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x804, 1200
    END
END
